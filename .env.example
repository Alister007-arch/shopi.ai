# Trovi Environment Variables
# Obtain free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
PORT=8000
# Environment & Mode
ENVIRONMENT=development
DEMO_MODE=false

# Initial Admin Account (Seeded on first run if provided; names in .env.example, no values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database Configuration (SQLite path or Postgres URL)
SHOPI_DB_PATH=data/shopai.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Transactional Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# SMS & WhatsApp Delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=

